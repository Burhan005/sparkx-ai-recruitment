# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparkx_recruitment

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# JWT & Security Configuration
JWT_SECRET_KEY=sparkx-secure-auth-secret-key-2026-prod

# Google Gemini API Key (Optional for live LLM Generative AI mode)
# If provided, SparkX uses Gemini 1.5/2.0 Flash for real-time semantic interview evaluation.
# If empty, the built-in Deterministic NLP Text Quality Analyzer runs automatically with zero crashes.
GEMINI_API_KEY=

# Live SMTP Email Delivery (Optional)
# If provided, SparkX sends real emails for interview invitations, updates, and password reset codes.
# Works with Gmail (App Password), Outlook, SendGrid, Amazon SES, or custom SMTP server.
# If left empty, emails are logged in development mode without sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true