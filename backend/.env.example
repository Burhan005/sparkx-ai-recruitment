# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparkx_recruitment

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Google Gemini API Key (Optional for live LLM Generative AI mode)
# If provided, SparkX uses Gemini 1.5/2.0 Flash for real-time semantic interview evaluation.
# If empty, the built-in Deterministic NLP Text Quality Analyzer runs automatically with zero crashes.
GEMINI_API_KEY=